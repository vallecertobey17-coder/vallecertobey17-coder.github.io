---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn't exist.">
  <section class="wrap nf">
    <span class="mono muted">Error 404</span>
    <h1>Lost</h1>
    <p class="muted" style="max-width:44ch">This page doesn't exist or has moved. Head back to the homepage to see the work.</p>
    <div class="ctas"><a class="btn solid" href="/">Back to home <span class="arr" aria-hidden="true">→</span></a><a class="btn" href="/#work">See the work</a></div>
  </section>
</Base>
